# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Nunca faça commit do arquivo ".env" (ele já está no .gitignore).

# Configuração do banco de dados MySQL (ver docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=db

# Porta em que a API Express sobe
PORT=8081
